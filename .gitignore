# MATLAB / Octave
*.asv
*.mat
octave-workspace
slprj/

# generated outputs (regenerate, don't commit)
results/figures/*.png
results/logs/*
!results/figures/.gitkeep
!results/logs/.gitkeep

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# test-script generated figures (regenerate by re-running the test, don't commit)
test1_*.png
test2_*.png
test3_*.png
test4_*.png

# MATLAB Project metadata (auto-generated by File > New Project > From Folder)
*.prj
resources/project/
.gitattributes

# Simulation run outputs regenerate on every run -- don't commit them,
# except the one example kept as a fallback if live execution fails.
results/2*/
!results/example_run/
!results/example_run/**

# Dev-validation tooling output (regenerate via validate_merged_project.m)
validation/

# run_benchmarks.m / validate_merged_project.m output folders (not timestamped)
results/merged_*/
results/baseline_truth/
results/ekf_seed_*/
